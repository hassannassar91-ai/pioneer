# Copy to .env locally (do not commit .env). On Render/Railway, set these in the dashboard.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=pioneer-web.onrender.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://pioneer-web.onrender.com

# Optional: PostgreSQL from your host (e.g. Render Postgres). If unset, SQLite is used (dev only).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
