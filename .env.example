# Copy to .env locally (do not commit .env). On Render, set these in the dashboard.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=pss-om.onrender.com,pss-om.com,www.pss-om.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://pss-om.onrender.com,https://pss-om.com,https://www.pss-om.com

# No DATABASE_URL needed for production — sessions use signed cookies.
